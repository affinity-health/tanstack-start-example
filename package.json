{
  "name": "tanstack-start-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "NODE_ENV=production bun server.ts",
    "example": "bun example.ts",
    "build": "bun build --target=bun --minify --outdir=dist server.ts",
    "check": "bun test && oxlint && oxfmt --check && tsc --noEmit",
    "check-types": "tsc --noEmit",
    "format": "oxfmt --write",
    "test": "bun test"
  },
  "dependencies": {
    "@affinity-health/sdk": "1.9.0-beta.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.0"
  },
  "packageManager": "bun@1.3.12"
}
