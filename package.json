{
  "name": "tanstack-start-example",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.2",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "@orpc/server": "^1.14.6",
      "@orpc/client": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "better-auth": "1.6.23",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.93.12",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:web": "vp run --filter web dev",
    "db:generate": "vp run --filter @tanstack-start-example/db db:generate",
    "deploy": "vp run --filter @tanstack-start-example/infra deploy",
    "destroy": "vp run --filter @tanstack-start-example/infra destroy"
  },
  "dependencies": {
    "@tanstack-start-example/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tanstack-start-example/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rolldown": "1.1.4",
    "typescript": "catalog:",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "packageManager": "bun@1.3.12"
}
