# Copy to .env. Bun reads it automatically.
AFFINITY_TEST_API_KEY=
AFFINITY_PRODUCTION_API_KEY=

# Optional locally. `bun run deploy` generates and saves these if absent.
# DEMO_PIN= (at least 10 digits)
# DEMO_SESSION_SECRET= (at least 32 characters)

# Optional IDs for experimenting with patient resolution and previews.
# AFFINITY_PRACTICE_ID=prac_...
# AFFINITY_MEDICATION_ID=cat_...
