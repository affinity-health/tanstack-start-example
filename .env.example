# SDK 2.0.0-beta.6 / API 2026-10-20. Standalone example only. Copy to .env.dev and supply your own Test key.
AFFINITY_API_URL=https://api.affinityrx.com
AFFINITY_API_KEY=

# Optional local Devbox API access. Never bind this to the public demo.
# DEVBOX_API_KEY=

# Hosted/local Worker development uses Alchemy and injected configuration instead:
# AFFINITY_HARBOR_DEMO_API_KEY
# AFFINITY_DEMO_SESSION_SECRET
